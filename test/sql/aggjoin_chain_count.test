# ============================================================================
# SUM / MIN / MAX / AVG / COUNT(col) — piecewise aggregate propagation.
# Fact-center star: 5 rows/key over 50000 keys on every side -> 31,250,000-row
# join. The aggregate logical rewrite threads each aggregate's partial state through the
# fold (_freq for COUNT/SUM, set-safe pass-through for MIN/MAX, sum+count pair
# for AVG). All ground-truth values were taken from a native run. dv is DOUBLE
# (integer SUM binds sum_no_overflow/HUGEINT and bails -> see the last BAIL).
# ============================================================================
statement ok
CREATE TABLE ad1(k INT, dn DOUBLE);

statement ok
INSERT INTO ad1 SELECT i % 50000, (i % 11) * 1.0 FROM range(250000) t(i);

statement ok
CREATE TABLE ad2(k INT);

statement ok
INSERT INTO ad2 SELECT i % 50000 FROM range(250000) t(i);

statement ok
CREATE TABLE ad3(k INT);

statement ok
INSERT INTO ad3 SELECT i % 50000 FROM range(250000) t(i);

statement ok
CREATE TABLE af(k1 INT, k2 INT, k3 INT, dv DOUBLE, iv INT, cat INT);

statement ok
INSERT INTO af SELECT i % 50000, i % 50000, i % 50000, (i % 8) * 1.0, i % 8, i % 5 FROM range(250000) t(i);

# FIRE: ungrouped SUM over a DOUBLE measure on the fact (home = root center).
statement ok
SELECT aggjoin_reset_rewrite_marker();

query R
SELECT SUM(af.dv) FROM af, ad1, ad2, ad3
WHERE af.k1 = ad1.k AND af.k2 = ad2.k AND af.k3 = ad3.k;
----
109375000.0

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# FIRE: set-safe MIN/MAX (no _freq weight) + COUNT(col) (SUM of _freq over
# non-null rows) in one ungrouped query.
statement ok
SELECT aggjoin_reset_rewrite_marker();

query III
SELECT MIN(af.iv), MAX(af.iv), COUNT(af.iv) FROM af, ad1, ad2, ad3
WHERE af.k1 = ad1.k AND af.k2 = ad2.k AND af.k3 = ad3.k;
----
0	7	31250000

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# FIRE: AVG grouped by a fact attribute (guard = star center). AVG carries a
# weighted sum + weighted count pair and divides at the root.
statement ok
SELECT aggjoin_reset_rewrite_marker();

query IR
SELECT af.cat, ROUND(AVG(af.dv), 6) FROM af, ad1, ad2, ad3
WHERE af.k1 = ad1.k AND af.k2 = ad2.k AND af.k3 = ad3.k
GROUP BY af.cat ORDER BY af.cat;
----
0	3.5
1	3.5
2	3.5
3	3.5
4	3.5

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# FIRE: multi-node aggregates — SUM over the fact AND SUM over a DIMENSION
