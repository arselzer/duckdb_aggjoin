# name: test/sql/aggjoin_chain_count.test
# description: N-relation linear-chain COUNT(*) frequency-propagation logical rewrite (MVP)
# group: [aggjoin]
# differential: skip
#   Uses aggjoin_last_rewrite() fire-assertions, which require the optimizer to be
#   live (disabled, the marker is always 'none'). Every expected count was taken
#   from a native (extension-disabled) run, so the differential pass adds nothing.
#
# The logical rewrite fires only on large chains with an estimated multiplicity BLOWUP
# (join product >> inputs); on near-1:1 chains it bails to native (the extra
# GROUP-BYs would lose). FIRE cases assert BOTH the value AND that the logical rewrite
# fired (aggjoin_last_rewrite() = 'chain_count'); BAIL cases assert the value is
# still correct via native AND that the logical rewrite did NOT fire. All fixtures are
# >= 50K rows. The fire-assertion is the only way to test these rewrites — they
# lower to native HASH_GROUP_BY/HASH_JOIN and are invisible in EXPLAIN.

require aggjoin

# ============================================================================
# FIRE: 3-table chain with a 100x fan-out on the last edge -> 6,000,000.
# ============================================================================
statement ok
CREATE TABLE bl_t2(c INT);

statement ok
INSERT INTO bl_t2 SELECT i % 600 FROM range(60000) t(i);

statement ok
CREATE TABLE bl_t1(b INT, c INT);

statement ok
INSERT INTO bl_t1 SELECT i, i % 600 FROM range(60000) t(i);

statement ok
CREATE TABLE bl_t0(b INT);

statement ok
INSERT INTO bl_t0 SELECT i FROM range(60000) t(i);

statement ok
SELECT aggjoin_reset_rewrite_marker();

query I
SELECT COUNT(*) FROM bl_t0, bl_t1, bl_t2
WHERE bl_t0.b = bl_t1.b AND bl_t1.c = bl_t2.c;
----
6000000

query T
SELECT aggjoin_last_rewrite();
----
chain_count

