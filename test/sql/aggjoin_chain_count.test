# FIRE: GROUP BY columns on DIFFERENT nodes (mc_t0.g1 + mc_t2.g3).
statement ok
SELECT aggjoin_reset_rewrite_marker();

query IIII
SELECT mc_t0.g1, mc_t2.g3, COUNT(*), SUM(mc_t1.b) FROM mc_t0, mc_t1, mc_t2
WHERE mc_t0.b = mc_t1.b AND mc_t1.c = mc_t2.c
GROUP BY mc_t0.g1, mc_t2.g3 ORDER BY mc_t0.g1, mc_t2.g3;
----
0	0	1000000	29997000000
0	1	1000000	30000000000
1	0	1000000	30001000000
1	1	1000000	29998000000
2	0	1000000	29999000000
2	1	1000000	30002000000

query T
SELECT aggjoin_last_rewrite();
