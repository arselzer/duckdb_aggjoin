1	21875000.0	31249625.0
2	21875000.0	31248875.0
3	21875000.0	31249500.0
4	21875000.0	31250125.0

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# FIRE: COUNT(*) + SUM + MIN + MAX mixed in one grouped query.
statement ok
SELECT aggjoin_reset_rewrite_marker();

query IIRII
SELECT af.cat, COUNT(*), SUM(af.dv), MIN(af.iv), MAX(af.iv) FROM af, ad1, ad2, ad3
WHERE af.k1 = ad1.k AND af.k2 = ad2.k AND af.k3 = ad3.k
GROUP BY af.cat ORDER BY af.cat;
----
0	6250000	21875000.0	0	7
1	6250000	21875000.0	0	7
2	6250000	21875000.0	0	7
3	6250000	21875000.0	0	7
4	6250000	21875000.0	0	7

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# FIRE: integer SUM (HUGEINT result) is accumulated EXACTLY in HUGEINT through the
# logical rewrite. Small-value case over af.iv (INT) -- fires and matches native.
statement ok
SELECT aggjoin_reset_rewrite_marker();

query I
SELECT SUM(af.iv) FROM af, ad1, ad2, ad3
WHERE af.k1 = ad1.k AND af.k2 = ad2.k AND af.k3 = ad3.k;
----
109375000

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# ============================================================================
# EXACT-INTEGER GUARD: SUM over a BIGINT measure whose join-multiplied total
# exceeds 2^53, so a DOUBLE accumulator (the original COUNT-only MVP's _freq
# type) would silently round. The expected values are the EXACT native results;
# their DOUBLE round-trips differ (e.g. 3906246093921875000 vs ...874944), so any
# regression to DOUBLE arithmetic fails this test. big = i*1000003 + 7.
# ============================================================================
statement ok
CREATE TABLE bi_d1(k INT);

statement ok
INSERT INTO bi_d1 SELECT i % 50000 FROM range(250000) t(i);

statement ok
CREATE TABLE bi_d2(k INT);

statement ok
INSERT INTO bi_d2 SELECT i % 50000 FROM range(250000) t(i);

statement ok
CREATE TABLE bi_d3(k INT);

statement ok
INSERT INTO bi_d3 SELECT i % 50000 FROM range(250000) t(i);

statement ok
CREATE TABLE bi_f(k1 INT, k2 INT, k3 INT, big BIGINT, cat INT);

statement ok
INSERT INTO bi_f SELECT i % 50000, i % 50000, i % 50000, (i * 1000003 + 7)::BIGINT, i % 5 FROM range(250000) t(i);

# Ungrouped exact SUM (> 2^53). DOUBLE would give 3906246093921874944.
statement ok
SELECT aggjoin_reset_rewrite_marker();

query I
SELECT SUM(bi_f.big) FROM bi_f, bi_d1, bi_d2, bi_d3
WHERE bi_f.k1 = bi_d1.k AND bi_f.k2 = bi_d2.k AND bi_f.k3 = bi_d3.k;
----
3906246093921875000

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# Grouped exact SUM by a fact attribute (piecewise) -- each group > 2^53.
statement ok
SELECT aggjoin_reset_rewrite_marker();

query II
SELECT bi_f.cat, SUM(bi_f.big) FROM bi_f, bi_d1, bi_d2, bi_d3
WHERE bi_f.k1 = bi_d1.k AND bi_f.k2 = bi_d2.k AND bi_f.k3 = bi_d3.k
GROUP BY bi_f.cat ORDER BY bi_f.cat;
----
0	781236718746875000
1	781242968765625000
2	781249218784375000
3	781255468803125000
4	781261718821875000

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# COUNT(col) + exact SUM mixed: COUNT also accumulates in HUGEINT now.
statement ok
SELECT aggjoin_reset_rewrite_marker();

query II
SELECT COUNT(bi_f.big), SUM(bi_f.big) FROM bi_f, bi_d1, bi_d2, bi_d3
WHERE bi_f.k1 = bi_d1.k AND bi_f.k2 = bi_d2.k AND bi_f.k3 = bi_d3.k;
----
31250000	3906246093921875000

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# AVG over the same BIGINT measure: the numerator (= the SUM above, 3.9e18) exceeds
# 2^53, so a DOUBLE numerator would round. AVG(integer) keeps numerator AND
# denominator exact in HUGEINT and divides as DOUBLE only at the root, reproducing
# native AVG(int) = (double)int128_sum/(double)count EXACTLY. The .5 fraction is the
# tell -- it survives only with the exact numerator.
statement ok
SELECT aggjoin_reset_rewrite_marker();

query R
SELECT AVG(bi_f.big) FROM bi_f, bi_d1, bi_d2, bi_d3
WHERE bi_f.k1 = bi_d1.k AND bi_f.k2 = bi_d2.k AND bi_f.k3 = bi_d3.k;
----
124999875005.5

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# Grouped exact AVG(integer) -- each group's numerator also exceeds 2^53.
statement ok
SELECT aggjoin_reset_rewrite_marker();

query IR
SELECT bi_f.cat, AVG(bi_f.big) FROM bi_f, bi_d1, bi_d2, bi_d3
WHERE bi_f.k1 = bi_d1.k AND bi_f.k2 = bi_d2.k AND bi_f.k3 = bi_d3.k
GROUP BY bi_f.cat ORDER BY bi_f.cat;
----
0	124997874999.5
1	124998875002.5
2	124999875005.5
3	125000875008.5
4	125001875011.5

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# ============================================================================
# EXACT-DECIMAL GUARD: SUM over a DECIMAL(18,2) money column. DuckDB SUM(decimal)
# returns DECIMAL(38,s); the logical rewrite accumulates in DECIMAL(38,s), not DOUBLE.
# One fact row carries an odd cent (+0.01), so the join-multiplied total has an odd
# unscaled value above 2^53 -- non-DOUBLE-representable, so a DOUBLE-accumulator
# regression would round (the .25 / odd cents would not survive). Values are the
# exact native results.
# ============================================================================
statement ok
CREATE TABLE dc_d1(k INT);

statement ok
INSERT INTO dc_d1 SELECT i % 50000 FROM range(250000) t(i);

statement ok
CREATE TABLE dc_d2(k INT);

statement ok
INSERT INTO dc_d2 SELECT i % 50000 FROM range(250000) t(i);

statement ok
CREATE TABLE dc_d3(k INT);

statement ok
INSERT INTO dc_d3 SELECT i % 50000 FROM range(250000) t(i);

statement ok
CREATE TABLE dc_f(k1 INT, k2 INT, k3 INT, amt DECIMAL(18,2), cat INT);

statement ok
INSERT INTO dc_f SELECT i % 50000, i % 50000, i % 50000,
  ((((i * 1000003 + 7) % 1000000000) / 100.0) + CASE WHEN i = 0 THEN 0.01 ELSE 0.00 END)::DECIMAL(18,2),
  i % 5 FROM range(250000) t(i);

statement ok
SELECT aggjoin_reset_rewrite_marker();

query R
SELECT SUM(dc_f.amt) FROM dc_f, dc_d1, dc_d2, dc_d3
WHERE dc_f.k1 = dc_d1.k AND dc_f.k2 = dc_d2.k AND dc_f.k3 = dc_d3.k;
----
156210939218751.25

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# Grouped exact DECIMAL SUM -- group 0 carries the odd-cent fact row.
statement ok
SELECT aggjoin_reset_rewrite_marker();

query IR
SELECT dc_f.cat, SUM(dc_f.amt) FROM dc_f, dc_d1, dc_d2, dc_d3
WHERE dc_f.k1 = dc_d1.k AND dc_f.k2 = dc_d2.k AND dc_f.k3 = dc_d3.k
GROUP BY dc_f.cat ORDER BY dc_f.cat;
----
0	31117187468751.25
1	31179687656250.00
2	31242187843750.00
3	31304688031250.00
4	31367188218750.00

query T
SELECT aggjoin_last_rewrite();
----
chain_count

