# name: test/sql/aggjoin_grouping_sets.test
# description: ROLLUP / CUBE / GROUPING SETS lower to one LogicalAggregate
#              with multiple grouping sets. The fused operator only computes
#              the primary grouping, so the planner must bail and leave these
#              to native execution (pre-fix the extension silently dropped
#              the higher grouping levels and GROUPING() hit internal errors).
# group: [aggjoin]

require aggjoin

statement ok
CREATE TABLE gr (x INT, y INT, val DOUBLE);

statement ok
INSERT INTO gr VALUES (1, 10, 1.0), (2, 10, 2.0), (3, 20, 3.0);

statement ok
CREATE TABLE gs (x INT);

statement ok
INSERT INTO gs VALUES (1), (2), (3);

query II rowsort
SELECT gr.x, CAST(SUM(gr.val) AS INTEGER)
FROM gr JOIN gs ON gr.x = gs.x GROUP BY ROLLUP(gr.x);
----
1	1
2	2
3	3
NULL	6

query II rowsort
SELECT gr.x, CAST(SUM(gr.val) AS INTEGER)
FROM gr JOIN gs ON gr.x = gs.x GROUP BY CUBE(gr.x);
----
1	1
2	2
3	3
NULL	6

query III rowsort
SELECT gr.y, gr.x, CAST(SUM(gr.val) AS INTEGER)
FROM gr JOIN gs ON gr.x = gs.x GROUP BY ROLLUP(gr.y, gr.x);
----
10	1	1
10	2	2
10	NULL	3
20	3	3
20	NULL	3
NULL	NULL	6

query III rowsort
SELECT gr.x, GROUPING(gr.x), CAST(SUM(gr.val) AS INTEGER)
FROM gr JOIN gs ON gr.x = gs.x GROUP BY GROUPING SETS ((gr.x), ());
----
1	0	1
2	0	2
3	0	3
NULL	1	6

# Plain GROUP BY on the same tables must still produce identical results
# (and remains eligible for the fused operator).
query II rowsort
SELECT gr.x, CAST(SUM(gr.val) AS INTEGER)
FROM gr JOIN gs ON gr.x = gs.x GROUP BY gr.x;
----
1	1
2	2
3	3
