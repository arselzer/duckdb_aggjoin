statement ok
INSERT INTO q3 SELECT i % 1200 FROM range(60000) t(i);

statement ok
CREATE TABLE q2(c INT, d INT);

statement ok
INSERT INTO q2 SELECT i, i % 1200 FROM range(60000) t(i);

statement ok
CREATE TABLE q1(b INT, c INT);

statement ok
INSERT INTO q1 SELECT i, i FROM range(60000) t(i);

statement ok
CREATE TABLE q0(b INT);

statement ok
INSERT INTO q0 SELECT i FROM range(60000) t(i);

statement ok
SELECT aggjoin_reset_rewrite_marker();

query I
SELECT COUNT(*) FROM q0, q1, q2, q3
WHERE q0.b = q1.b AND q1.c = q2.c AND q2.d = q3.d;
----
3000000

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# ============================================================================
# BAIL (1:1 PK-FK chain): no blowup -> native; correct value, logical rewrite did NOT fire.
# ============================================================================
statement ok
CREATE TABLE pf3(d INT);

statement ok
INSERT INTO pf3 SELECT i FROM range(200000) t(i);

statement ok
CREATE TABLE pf2(c INT, d INT);

statement ok
INSERT INTO pf2 SELECT i, i FROM range(200000) t(i);

statement ok
CREATE TABLE pf1(b INT, c INT);

statement ok
INSERT INTO pf1 SELECT i, i FROM range(200000) t(i);

statement ok
CREATE TABLE pf0(b INT);

statement ok
INSERT INTO pf0 SELECT i FROM range(200000) t(i);

statement ok
SELECT aggjoin_reset_rewrite_marker();

query I
SELECT COUNT(*) FROM pf0, pf1, pf2, pf3
WHERE pf0.b = pf1.b AND pf1.c = pf2.c AND pf2.d = pf3.d;
----
200000

query T
SELECT aggjoin_last_rewrite() != 'chain_count';
----
true

# ============================================================================
# FIRE (general tree / STAR): a fact center joined to 3 dimensions on distinct
# columns (center degree 3 -- not a linear chain). 5 rows/key on each side over
# 50000 keys: 50000 * 5 * 5^3 = 31,250,000. Exercises the multi-child tree fold.
# ============================================================================
statement ok
CREATE TABLE sd1(k INT);

statement ok
INSERT INTO sd1 SELECT i % 50000 FROM range(250000) t(i);

statement ok
CREATE TABLE sd2(k INT);

statement ok
INSERT INTO sd2 SELECT i % 50000 FROM range(250000) t(i);

statement ok
CREATE TABLE sd3(k INT);

statement ok
INSERT INTO sd3 SELECT i % 50000 FROM range(250000) t(i);

statement ok
CREATE TABLE sf(k1 INT, k2 INT, k3 INT, m INT);

statement ok
INSERT INTO sf SELECT i % 50000, i % 50000, i % 50000, i % 4 FROM range(250000) t(i);

statement ok
SELECT aggjoin_reset_rewrite_marker();

query I
SELECT COUNT(*) FROM sf, sd1, sd2, sd3
WHERE sf.k1 = sd1.k AND sf.k2 = sd2.k AND sf.k3 = sd3.k;
----
31250000

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# Grouped by a FACT attribute -> the guard is the star CENTER (interior root,
# which the linear MVP could not handle). 31,250,000 / 4 = 7,812,500 per group.
statement ok
SELECT aggjoin_reset_rewrite_marker();

query II
SELECT sf.m, COUNT(*) FROM sf, sd1, sd2, sd3
WHERE sf.k1 = sd1.k AND sf.k2 = sd2.k AND sf.k3 = sd3.k
GROUP BY sf.m ORDER BY sf.m;
----
0	7812500
1	7812500
2	7812500
3	7812500

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# Grouped by columns on two sibling dimensions. The GROUP BY columns must be
# carried from separate child folds back to the fact root without collapsing.
statement ok
ALTER TABLE sd1 ADD COLUMN g1 INT;

statement ok
UPDATE sd1 SET g1 = k % 2;

statement ok
ALTER TABLE sd2 ADD COLUMN g2 INT;

statement ok
UPDATE sd2 SET g2 = k % 3;

statement ok
SELECT aggjoin_reset_rewrite_marker();

query III
SELECT sd1.g1, sd2.g2, COUNT(*) FROM sf, sd1, sd2, sd3
WHERE sf.k1 = sd1.k AND sf.k2 = sd2.k AND sf.k3 = sd3.k
GROUP BY sd1.g1, sd2.g2 ORDER BY sd1.g1, sd2.g2;
----
0	0	5208750
0	1	5208125
0	2	5208125
1	0	5208125
1	1	5208750
1	2	5208125

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# ============================================================================
# FIRE (grouped): GROUP BY a column on the root endpoint. The group column is
# low-cardinality so CompressedMaterialization wraps it -> exercises the compress
# offset re-emit path. g = i%10 (6000 rows each) * 100x fan-out = 600000 / group.
# ============================================================================
statement ok
CREATE TABLE gc_t2(c INT);

statement ok
INSERT INTO gc_t2 SELECT i % 600 FROM range(60000) t(i);

statement ok
CREATE TABLE gc_t1(b INT, c INT);

statement ok
INSERT INTO gc_t1 SELECT i, i % 600 FROM range(60000) t(i);

statement ok
CREATE TABLE gc_t0(b INT, g INT);

statement ok
INSERT INTO gc_t0 SELECT i, i % 10 FROM range(60000) t(i);

statement ok
SELECT aggjoin_reset_rewrite_marker();

query II
SELECT gc_t0.g, COUNT(*) FROM gc_t0, gc_t1, gc_t2
WHERE gc_t0.b = gc_t1.b AND gc_t1.c = gc_t2.c
GROUP BY gc_t0.g ORDER BY gc_t0.g;
----
0	600000
1	600000
2	600000
3	600000
4	600000
5	600000
6	600000
7	600000
8	600000
9	600000

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# FIRE (grouped): GROUP BY columns can live on different tree nodes.
statement ok
SELECT aggjoin_reset_rewrite_marker();

query III
SELECT gc_t0.g, gc_t2.c, COUNT(*) FROM gc_t0, gc_t1, gc_t2
WHERE gc_t0.b = gc_t1.b AND gc_t1.c = gc_t2.c
GROUP BY gc_t0.g, gc_t2.c ORDER BY gc_t0.g, gc_t2.c LIMIT 3;
----
0	0	10000
0	10	10000
0	20	10000

query T
SELECT aggjoin_last_rewrite();
----
chain_count

