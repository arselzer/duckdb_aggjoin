chain_count

# ============================================================================
# SET-SAFE AGGREGATES: BOOL_AND / BOOL_OR / BIT_AND / BIT_OR are idempotent under
# multiplicity (repeating a value freq times doesn't change the result), so the
# fold passes them straight through with NO _freq weighting -- like MIN/MAX.
# BIT_XOR is NOT set-safe (cancels on even repeats) and must bail. 3-table chain
# with a 100x fan-out -> 6,000,000 join rows.
# ============================================================================
statement ok
CREATE TABLE ss_t2(c INT);

statement ok
INSERT INTO ss_t2 SELECT i % 600 FROM range(60000) t(i);

statement ok
CREATE TABLE ss_t1(b INT, c INT);

statement ok
INSERT INTO ss_t1 SELECT i, i % 600 FROM range(60000) t(i);

statement ok
CREATE TABLE ss_t0(b INT, flag BOOLEAN, bits INTEGER, cat INT);

statement ok
INSERT INTO ss_t0 SELECT i, (i % 7 <> 0), (i % 64), i % 2 FROM range(60000) t(i);

# FIRE: all four set-safe aggregates in one ungrouped query.
statement ok
SELECT aggjoin_reset_rewrite_marker();

query TTII
SELECT bool_and(ss_t0.flag), bool_or(ss_t0.flag), bit_and(ss_t0.bits), bit_or(ss_t0.bits)
FROM ss_t0, ss_t1, ss_t2 WHERE ss_t0.b = ss_t1.b AND ss_t1.c = ss_t2.c;
----
false	true	0	63

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# FIRE: grouped set-safe aggregates.
statement ok
SELECT aggjoin_reset_rewrite_marker();

query ITTII
SELECT ss_t0.cat, bool_and(ss_t0.flag), bool_or(ss_t0.flag), bit_and(ss_t0.bits), bit_or(ss_t0.bits)
FROM ss_t0, ss_t1, ss_t2 WHERE ss_t0.b = ss_t1.b AND ss_t1.c = ss_t2.c
GROUP BY ss_t0.cat ORDER BY ss_t0.cat;
----
0	false	true	0	62
1	false	true	1	63

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# BAIL: BIT_XOR is multiplicity-sensitive (x ^ x = 0) -> stays native; value correct.
statement ok
SELECT aggjoin_reset_rewrite_marker();

query I
SELECT bit_xor(ss_t0.bits) FROM ss_t0, ss_t1, ss_t2
WHERE ss_t0.b = ss_t1.b AND ss_t1.c = ss_t2.c;
----
0

query T
SELECT aggjoin_last_rewrite() != 'chain_count';
----
true

# ============================================================================
# VAR / STDDEV via EXACT HUGEINT moments. The variance numerator n·Σx² − (Σx)² is
# an exact non-negative integer for integer x, so the cancellation that plagues the
# DOUBLE moment form vanishes -- and the result is DETERMINISTIC and the correctly-
# rounded true value (native var_pop is thread-dependent: parallel Welford). So the
# logical rewrite is the more accurate AND reproducible answer; we ROUND for the assertion
# (logical rewrite and native agree to ~7 digits). Gated to <= 32-bit integer inputs to stay
# overflow-safe (n·Σx² << HUGEINT max). 3-chain, 100x fan-out -> 6,000,000 rows.
# ============================================================================
statement ok
CREATE TABLE vr_t2(c INT);

statement ok
INSERT INTO vr_t2 SELECT i % 600 FROM range(60000) t(i);

statement ok
CREATE TABLE vr_t1(b INT, c INT);

statement ok
INSERT INTO vr_t1 SELECT i, i % 600 FROM range(60000) t(i);

statement ok
CREATE TABLE vr_t0(b INT, v INT, cat INT);

statement ok
INSERT INTO vr_t0 SELECT i, (i % 97), i % 2 FROM range(60000) t(i);

# FIRE: VAR_POP / VAR_SAMP / STDDEV_POP / STDDEV_SAMP in one query (deterministic).
statement ok
SELECT aggjoin_reset_rewrite_marker();

query RRRR
SELECT ROUND(VAR_POP(vr_t0.v), 6), ROUND(VAR_SAMP(vr_t0.v), 6),
       ROUND(STDDEV_POP(vr_t0.v), 6), ROUND(STDDEV_SAMP(vr_t0.v), 6)
FROM vr_t0, vr_t1, vr_t2 WHERE vr_t0.b = vr_t1.b AND vr_t1.c = vr_t2.c;
----
783.928676	783.928806	27.998726	27.998729

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# FIRE: VARIANCE = VAR_SAMP, STDDEV = STDDEV_SAMP (SQL-standard sample defaults).
statement ok
SELECT aggjoin_reset_rewrite_marker();

query RR
SELECT ROUND(VARIANCE(vr_t0.v), 6), ROUND(STDDEV(vr_t0.v), 6)
FROM vr_t0, vr_t1, vr_t2 WHERE vr_t0.b = vr_t1.b AND vr_t1.c = vr_t2.c;
----
783.928806	27.998729

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# FIRE: grouped VAR_POP by a fact attribute.
statement ok
SELECT aggjoin_reset_rewrite_marker();

query IR
SELECT vr_t0.cat, ROUND(VAR_POP(vr_t0.v), 6) FROM vr_t0, vr_t1, vr_t2
WHERE vr_t0.b = vr_t1.b AND vr_t1.c = vr_t2.c
GROUP BY vr_t0.cat ORDER BY vr_t0.cat;
----
0	783.948008
1	783.909343

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# FIRE: a BIGINT input now fires when column STATISTICS bound the actual values
# small enough that the exact HUGEINT moment can't overflow.  bv holds 0..96, so
# the stats-driven overflow guard admits it (value identical to native — the
# exact moment is the oracle).  bh holds the SAME values × 1e14 (large) and still
# bails, since the stats then prove an overflow risk.
statement ok
CREATE TABLE vr_big(b INT, bv BIGINT, bh BIGINT, bv_u UBIGINT, bv_h HUGEINT);

statement ok
INSERT INTO vr_big SELECT i, (i % 97)::BIGINT, (i % 97)::BIGINT * 100000000000000, (i % 97)::UBIGINT, (i % 97)::HUGEINT FROM range(60000) t(i);

statement ok
SELECT aggjoin_reset_rewrite_marker();

query R
SELECT ROUND(VAR_POP(vr_big.bv), 6) FROM vr_big, vr_t1, vr_t2
WHERE vr_big.b = vr_t1.b AND vr_t1.c = vr_t2.c;
----
783.928676

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# FIRE: UBIGINT and HUGEINT inputs fire identically — same stats-driven admission
# (bounded 0..96), same exact value.  The moment accumulates in HUGEINT regardless
# of the input integer width, so the result is byte-identical to the BIGINT case.
statement ok
SELECT aggjoin_reset_rewrite_marker();

query R
SELECT ROUND(VAR_POP(vr_big.bv_u), 6) FROM vr_big, vr_t1, vr_t2
WHERE vr_big.b = vr_t1.b AND vr_t1.c = vr_t2.c;
----
783.928676

query T
SELECT aggjoin_last_rewrite();
----
chain_count

statement ok
SELECT aggjoin_reset_rewrite_marker();

query R
SELECT ROUND(VAR_POP(vr_big.bv_h), 6) FROM vr_big, vr_t1, vr_t2
WHERE vr_big.b = vr_t1.b AND vr_t1.c = vr_t2.c;
----
783.928676

query T
SELECT aggjoin_last_rewrite();
----
chain_count

# BAIL: the same column scaled up (bh ~ values × 1e14) overflows the exact moment,
# so the stats-driven overflow guard still bails to native.
statement ok
SELECT aggjoin_reset_rewrite_marker();

statement ok
SELECT VAR_POP(vr_big.bh) FROM vr_big, vr_t1, vr_t2
WHERE vr_big.b = vr_t1.b AND vr_t1.c = vr_t2.c;

query T
SELECT aggjoin_last_rewrite() != 'chain_count';
----
true
